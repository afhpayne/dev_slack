#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=brother-brscan5
VERSION=${VERSION:-1.7.0_0}
BUILD=${BUILD:-1}
TAG=${TAG:-_DBs}
PKGTYPE=${PKGTYPE:-tgz}

DEBVER=${VERSION/_/-}
DEBNAM=${PRGNAM#brother-}
DEBARC=amd64

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
# Unless $ARCH is already set, use uname -m for all other archs:
       *) ARCH=$( uname -m ) ;;
  esac
fi

# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/DBs}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
elif [ "$ARCH" = "aarch64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION

ar x $CWD/${DEBNAM}-${DEBVER}.${DEBARC}.deb data.tar.xz
mkdir -p $PRGNAM-$VERSION
tar -xf data.tar.xz -C $PRGNAM-$VERSION/
rm data.tar.xz

cd $PRGNAM-$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

cp -apr * $PKG/

bropath=opt/brother/scanner/brscan5

# strip deprecated SYSFS lines
sed -i '/SYSFS/d' \
    $PKG/$bropath/udev-rules/NN-brother-mfp-brscan5-1.0.2-2.rules

# SANE backend symlink
mkdir -p $PKG/usr/lib64/sane
ln -s /$bropath/libsane-brother5.so.1.0.7 \
    $PKG/usr/lib64/sane/libsane-brother5.so.1

# SANE backend registration
mkdir -p $PKG/etc/sane.d/dll.d
echo brother5 > $PKG/etc/sane.d/dll.d/brother5.conf

# config files at the path hard-coded in libsane-brother5
mkdir -p $PKG/etc/$bropath
cp -a $PKG/$bropath/brscan5.ini \
   $PKG/etc/$bropath/brscan5.ini.new
cp -a $PKG/$bropath/brsanenetdevice.cfg \
   $PKG/etc/$bropath/brsanenetdevice.cfg.new

# Brother libraries: SONAME symlinks in /usr/lib64
mkdir -p $PKG/usr/lib64
for lib in $PKG/$bropath/libLxBs*.so.*.*; do
  soname=$(readelf -d "$lib" | sed -n 's/.*(SONAME).*\[\(.*\)\]/\1/p')
  [ -n "$soname" ] || { echo "no SONAME in $lib"; exit 1; }
  ln -s ../../$bropath/$(basename $lib) $PKG/usr/lib64/$soname
done

mkdir -p $PKG/etc/udev/rules.d
install -m 644 \
    $PKG/$bropath/udev-rules/NN-brother-mfp-brscan5-1.0.2-2.rules \
    $PKG/etc/udev/rules.d/40-brother-brscan5.rules

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a $PKG/$bropath/doc/* $PKG/usr/doc/$PRGNAM-$VERSION/
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh  > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE

